{
  "name": "{{ project_name_kebab }}-backend",
  "version": "0.1.0",
  "description": "FastAPI backend for {{ project_name }}",
  "scripts": {
    "dev": "uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uvicorn main:app --host 0.0.0.0 --port 8000",
    "lint": "ruff check .",
    "format": "ruff format .",
    "typecheck": "mypy .",
    "test": "pytest",
    "test:watch": "pytest -x --watch",
    "test:coverage": "pytest --cov=backend --cov-report=html",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "python prisma/seed.py"
  },
  "dependencies": {
    "fastapi": "^0.110.0",
    "uvicorn": "^0.29.0",
    "pydantic": "^2.7.0",
    "pydantic-settings": "^2.3.0",
    "prisma": "^5.13.0",
    "@prisma/client": "^5.13.0",
    "python-jose": "^3.3.0",
    "passlib": "^1.7.4",
    "bcrypt": "^4.1.2",
    "python-multipart": "^0.0.6",
    "email-validator": "^2.1.0",
    "httpx": "^0.27.0",
    "python-dotenv": "^1.0.0",
    "structlog": "^24.1.0",
    "prometheus-client": "^0.19.0",
    "slowapi": "^0.1.9"
  },
  "devDependencies": {
    "pytest": "^8.2.0",
    "pytest-asyncio": "^0.23.0",
    "pytest-cov": "^5.0.0",
    "pytest-mock": "^3.12.0",
    "httpx": "^0.27.0",
    "ruff": "^0.4.0",
    "mypy": "^1.10.0",
    "types-bcrypt": "^4.0.0",
    "types-passlib": "^1.7.0"
  }
}